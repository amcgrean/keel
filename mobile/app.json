{
  "expo": {
    "name": "Keel",
    "slug": "keel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "keel",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#22282B"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.keel.coparent"
    },
    "android": {
      "package": "app.keel.coparent",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#22282B"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
